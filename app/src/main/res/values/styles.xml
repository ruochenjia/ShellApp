<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="AppTheme" parent="BaseAppTheme">
        <item name="android:textViewStyle">@style/AppTextView</item>
        <item name="android:editTextStyle">@style/AppEditText</item>
        <item name="android:buttonStyle">@style/AppButtonStyle</item>
        <item name="fontFamily">@font/standard</item>
        <item name="android:fontFamily">@font/standard</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">true</item>
        <item name="android:windowAnimationStyle">@style/SwitchActivityAnimation</item>
    </style>

    <style name="AppTheme.LaunchActivity" parent="AppTheme.NoActionBar">
        <item name="colorPrimary">@color/white</item>
        <item name="colorPrimaryDark">@color/white</item>
    </style>

    <style name="AppTheme.TextEditor" parent="AppTheme">
        <item name="fontFamily">@font/menu</item>
        <item name="android:fontFamily">@font/menu</item>
    </style>

    <style name="Menu" parent="AppTheme">
        <item name="fontFamily">@font/menu</item>
    </style>

    <style name="ActionBarSubtitleAppearance" parent="TextAppearance.Widget.AppCompat.Toolbar.Subtitle">
        <item name="android:textSize">14sp</item>
        <item name="fontFamily">@font/menu</item>
    </style>

    <style name="ActionBarTitleAppearance" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:textSize">20sp</item>
        <item name="fontFamily">@font/menu</item>
    </style>

    <style name="AppButtonStyle" parent="Widget.AppCompat.Button">
        <item name="fontFamily">@font/menu</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="AppEditText" parent="Widget.AppCompat.EditText" />

    <style name="AppTextView" parent="Widget.AppCompat.TextView">
        <item name="fontFamily">@font/menu</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="AppTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="AppTheme.NoTitleBar" parent="AppTheme">
        <item name="windowNoTitle">true</item>
    </style>

    <style name="BaseAppTheme" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>
    </style>

    <style name="SwitchActivityAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/fade_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/fade_out_left</item>
        <item name="android:activityCloseEnterAnimation">@anim/fade_in_left</item>
        <item name="android:activityCloseExitAnimation">@anim/fade_out_right</item>
    </style>
</resources>