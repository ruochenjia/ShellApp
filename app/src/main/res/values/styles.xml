<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="AppTheme.ActionBar" parent="ThemeOverlay.AppCompat.Dark.ActionBar">
        <item name="background">@color/app_theme</item>
        <item name="titleTextStyle">@style/AppTheme.ActionBar.TextAppearance</item>
        <item name="subtitleTextStyle">@style/AppTheme.ActionBar.SubtitleTextAppearance</item>
    </style>

    <style name="AppTheme.ActionBar1" parent="Widget.AppCompat.ActionBar">
        <item name="background">@color/app_theme</item>
        <item name="titleTextStyle">@style/AppTheme.ActionBar.TextAppearance</item>
        <item name="subtitleTextStyle">@style/AppTheme.ActionBar.SubtitleTextAppearance</item>
    </style>

    <style name="AppTheme.ActionBar.TextAppearance" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="AppTheme.ActionBar.SubtitleTextAppearance" parent="TextAppearance.AppCompat.Widget.ActionBar.Subtitle">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="AppTheme" parent="Theme.AppCompat.DayNight">
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="actionBarStyle">@style/AppTheme.ActionBar1</item>
        <item name="android:textViewStyle">@style/AppTheme.TextView</item>
        <item name="android:editTextStyle">@style/AppTheme.EditText</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/app_theme</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">true</item>
        <item name="android:windowAnimationStyle">@style/AppTheme.WindowAnimation</item>
    </style>

    <style name="AppTheme.TextView" parent="Widget.AppCompat.TextView">
        <item name="android:textSize">16sp</item>
        <item name="android:text">Text</item>
    </style>

    <style name="AppTheme.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:textSize">16sp</item>
        <item name="android:inputType">text</item>
    </style>

    <style name="Theme.LaunchActivity" parent="Theme.NoActionBar">
        <item name="colorPrimary">@color/white</item>
        <item name="colorPrimaryDark">@color/white</item>
    </style>

    <style name="Theme.NoActionBar" parent="AppTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="AppTheme.WindowAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/fade_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/fade_out_left</item>
        <item name="android:activityCloseEnterAnimation">@anim/fade_in_left</item>
        <item name="android:activityCloseExitAnimation">@anim/fade_out_right</item>
    </style>
</resources>