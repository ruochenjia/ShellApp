<?xml version="1.0" encoding="utf-8"?>
<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_height="match_parent"
    android:layout_width="match_parent"
    android:key="setting_preferences">
    <androidx.preference.PreferenceCategory android:title="@string/site_settings">
        <androidx.preference.SwitchPreference
            android:key="javascriptSwitch"
            android:title="@string/allow_javascript"
            android:summary="@string/allow_javascript_description"/>
        <androidx.preference.SwitchPreference
            android:key="loadsImagesAutomatically"
            android:title="@string/loads_images_automatically"
            android:summary="@string/empty_string"/>
        <androidx.preference.SwitchPreference
            android:key="allowContentAccess"
            android:title="@string/allow_content_access"
            android:summary="@string/empty_string"/>
        <androidx.preference.SwitchPreference
            android:key="allowFileAccess"
            android:title="@string/allow_file_access"
            android:summary="@string/allow_file_access_description"/>
        <androidx.preference.SwitchPreference
            android:key="allowLocationAccess"
            android:title="@string/allow_location_access"
            android:summary="@string/allow_location_access_description"/>
    </androidx.preference.PreferenceCategory>
    <androidx.preference.PreferenceCategory android:title="@string/browser_settings">
        <androidx.preference.SwitchPreference
            android:key="enableAppCache"
            android:title="@string/enable_app_cache"
            android:summary="@string/enable_app_cache_description"/>
        <androidx.preference.SwitchPreference
            android:key="enableDomStorage"
            android:title="@string/enable_dom_storage"
            android:summary="@string/empty_string"/>
        <androidx.preference.SwitchPreference
            android:key="setBuiltInZoomControls"
            android:title="@string/set_built_in_zoom_controls"
            android:summary="@string/set_built_in_zoom_controls_description"/>
        <androidx.preference.SwitchPreference
            android:key="setDisplayZoomControls"
            android:title="@string/set_display_zoom_controls"
            android:summary="@string/set_display_zoom_controls_description"/>
        <androidx.preference.SwitchPreference
            android:key="loadWithOverviewMode"
            android:title="@string/load_with_overview_mode"
            android:summary="@string/empty_string"/>
        <androidx.preference.SwitchPreference
            android:key="useWideViewPort"
            android:title="@string/use_wide_view_port"
            android:summary="@string/empty_string"/>
    </androidx.preference.PreferenceCategory>
    <androidx.preference.PreferenceCategory android:title="@string/privacy_settings">
        <androidx.preference.SwitchPreference
            android:key="cookieSwitch"
            android:title="@string/allow_cookies"
            android:summary="@string/allow_cookies_description"/>
        <androidx.preference.SwitchPreference
            android:key="thirdPartyCookieSwitch"
            android:title="@string/allow_third_party_cookies"
            android:summary="@string/allow_third_party_cookies_description"/>
        <androidx.preference.SwitchPreference
            android:key="automaticVpn"
            android:title="@string/automatic_vpn"
            android:summary="@string/automatic_vpn_description"/>
        <androidx.preference.SwitchPreference
            android:key="blockWebViewAds"
            android:title="@string/block_webview_ads"
            android:summary="@string/block_webview_ads_description"/>
    </androidx.preference.PreferenceCategory>
    <androidx.preference.PreferenceCategory android:title="@string/personalisation_settings">
        <androidx.preference.Preference
            android:key="homePageUrl"
            android:title="@string/home_page_url"/>
        <androidx.preference.Preference
            android:key="appStartPageUrl"
            android:title="@string/app_start_page_url"/>
        <androidx.preference.Preference
            android:key="downloadFolder"
            android:title="@string/download_folder"/>
    </androidx.preference.PreferenceCategory>
    <androidx.preference.PreferenceCategory android:title="@string/manage_storage">
        <androidx.preference.Preference
            android:key="clearCookies"
            android:title="@string/clear_cookies"
            android:summary="@string/clear_cookies_description"/>
        <androidx.preference.Preference
            android:key="clearBrowsingData"
            android:title="@string/clear_browsing_data"
            android:summary="@string/clear_browsing_data_description"/>
        <androidx.preference.Preference
            android:key="clearAppCache"
            android:title="@string/clear_app_cache"
            android:summary="@string/empty_string"/>
        <androidx.preference.Preference
            android:key="clearAppData"
            android:title="@string/clear_app_data"
            android:summary="@string/clear_app_data_description"/>
    </androidx.preference.PreferenceCategory>
    <androidx.preference.PreferenceCategory android:title="@string/application">
        <androidx.preference.SwitchPreference
            android:key="keepScreenOn"
            android:title="@string/keep_screen_on"
            android:summary="@string/keep_screen_on_description"/>
        <androidx.preference.Preference
            android:key="additionalFunctions"
            android:title="@string/additional_functions"
            android:summary="@string/empty_string"/>
        <androidx.preference.Preference
            android:key="about"
            android:title="@string/about"
            android:summary="@string/empty_string"/>
    </androidx.preference.PreferenceCategory>
</androidx.preference.PreferenceScreen>