<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    tools:context="android.gameengine.x86.uuidgenerator.uuidGenerateActivity">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|center_horizontal"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical">
        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/your_random_uuid"
            android:textColor="@color/contents"
            android:gravity="center"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/uuidDisplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:textColor="@color/contents_title"
            android:gravity="center"/>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/generateRandomUuid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/generate_random_uuid" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/copyToClipboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/copy_to_clipboard"/>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/copyToClipboardWithoutDashes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/copy_to_clipboard_without_dashes"/>
    </LinearLayout>
</RelativeLayout>