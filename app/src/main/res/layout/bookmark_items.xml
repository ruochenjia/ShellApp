<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bookmarkItem"
    android:layout_width="match_parent"
    android:layout_height="36dp"
    android:orientation="vertical">

    <View
        android:id="@+id/aaaaaaaaaaaaaaaa"
        android:layout_width="8dp"
        android:layout_height="match_parent"
        android:layout_alignParentStart="true"
        android:layout_alignParentLeft="true"
        android:visibility="invisible" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/bookmarkIcon"
        android:layout_width="36dp"
        android:layout_height="match_parent"
        android:layout_toEndOf="@id/aaaaaaaaaaaaaaaa"
        android:layout_toRightOf="@id/aaaaaaaaaaaaaaaa"
        android:background="@color/contents"
        app:srcCompat="@drawable/logo_clip" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentEnd="true"
        android:layout_alignParentRight="true"
        android:layout_toEndOf="@id/bookmarkIcon"
        android:layout_toRightOf="@id/bookmarkIcon"
        android:orientation="vertical">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/bookmarkTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:gravity="center_vertical"
            android:textColor="@color/contents_title" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/bookmarkSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:gravity="center_vertical"
            android:textColor="@color/contents" />
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatCheckBox
        android:id="@+id/selection"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentRight="true"
        android:visibility="gone" />
</RelativeLayout>