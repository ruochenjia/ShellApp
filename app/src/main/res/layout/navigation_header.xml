<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layout_gravity="center"
        android:background="@color/app_theme"
        android:gravity="center"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/navigationHeaderLogo"
            android:layout_width="50dp"
            android:layout_height="match_parent"
            android:gravity="center"
            app:srcCompat="@drawable/logo" />

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:fontFamily="@font/title"
            android:gravity="center"
            android:text="@string/app_name_short"
            android:textColor="@color/white"
            android:textSize="24sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/storagePartitionInternal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|center_horizontal"
            android:gravity="center"
            app:srcCompat="@drawable/storage_partition_internal" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/internal_storage"
                android:textSize="16sp" />

            <ProgressBar
                android:id="@+id/storagePartitionInternalProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:progressBackgroundTint="@color/contents"
                android:progressTint="@color/teal_700" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/storagePartitionInternalInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/contents"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/storagePartitionExternal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|center_horizontal"
            android:gravity="center"
            app:srcCompat="@drawable/storage_partition_external" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/external_sdcard"
                android:textSize="16sp" />

            <ProgressBar
                android:id="@+id/storagePartitionExternalProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:progressBackgroundTint="@color/contents"
                android:progressTint="@color/teal_700" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/storagePartitionExternalInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/contents"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/storagePartitionRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|center_horizontal"
            android:gravity="center"
            app:srcCompat="@drawable/storage_partitions" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/root_partition"
                android:textSize="16sp" />

            <ProgressBar
                android:id="@+id/storagePartitionRootProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:progressBackgroundTint="@color/contents"
                android:progressTint="@color/teal_700" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/storagePartitionRootInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/contents"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/storagePartitionData"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|center_horizontal"
            android:gravity="center"
            app:srcCompat="@drawable/storage_partitions" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/data_partition"
                android:textSize="16sp" />

            <ProgressBar
                android:id="@+id/storagePartitionDatarogressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:progressBackgroundTint="@color/contents"
                android:progressTint="@color/teal_700" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/storagePartitionDataInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/contents"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/storagePartitionCache"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|center_horizontal"
            android:gravity="center"
            app:srcCompat="@drawable/storage_partitions" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cache_partition"
                android:textSize="16sp" />

            <ProgressBar
                android:id="@+id/storagePartitionCacheProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:progressBackgroundTint="@color/contents"
                android:progressTint="@color/teal_700" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/storagePartitionCacheInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/contents"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/storagePartitionSystem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|center_horizontal"
            android:gravity="center"
            app:srcCompat="@drawable/storage_partitions" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/system_partition"
                android:textSize="16sp" />

            <ProgressBar
                android:id="@+id/storagePartitionSystemProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:progressBackgroundTint="@color/contents"
                android:progressTint="@color/teal_700" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/storagePartitionSystemInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/contents"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>